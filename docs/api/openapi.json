  "components": {
    "schemas": {
      "AddMemberRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "role": {
            "type": "integer",
            "title": "Role",
            "description": "目标角色:20=Editor / 10=Viewer(Admin 不能授予 Admin)"
          }
        },
        "type": "object",
        "required": [
          "username",
          "role"
        ],
        "title": "AddMemberRequest"
      },
      "AuditLogOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          },
          "ip": {
            "type": "string",
            "title": "Ip"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_id",
          "action",
          "target",
          "detail",
          "ip"
        ],
        "title": "AuditLogOut"
      },
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditLogOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "AuditPage"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "spaces": {
            "items": {
              "$ref": "#/components/schemas/SpaceBriefOut"
            },
            "type": "array",
            "title": "Spaces"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "user",
          "spaces",
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ],
        "title": "AuthResponse"
      },
      "ChangePasswordRequest": {
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Old Password"
          },
          "new_password": {
