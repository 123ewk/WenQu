# ============================================================================
# WenQu 配置模板(「配置即文档」,基准 02)
# 规则:
#   1. 优先级:环境变量 > .env > 代码默认值
#   2. 密钥只放 .env(不入库),YAML 结构化配置中禁止出现密钥
#   3. 生产部署:复制本文件为 .env 后逐项核对 —— 设计文档 9.2 的 Go-Live 14 项翻转
#      标注【生产必配】的变量在 prod 模式缺失时服务拒绝启动(fail-closed)
# ============================================================================

# ---------------------------- 部署基础 ----------------------------
APP_ENV=dev                      # dev | prod;生产必须显式设为 prod(触发 fail-closed 校验)
WEB_HTTP_PORT=80                 # web 对外端口

# ---------------------------- 数据存储 ----------------------------
# 连接串由 server/parser 使用;compose 场景 host 用服务名,本机开发用 localhost
APP_DATABASE_URL=postgresql+psycopg://wenqu:wenqu_dev_only@localhost:5432/wenqu  # 【生产必配】
POSTGRES_USER=wenqu              # 【生产必配】
POSTGRES_PASSWORD=wenqu_dev_only # 【生产必配】上线前必须更换强口令(翻转项 #2)
POSTGRES_DB=wenqu

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=wenqu           # 【生产必配】
MINIO_SECRET_KEY=wenqu_dev_only  # 【生产必配】上线前必须更换强口令(翻转项 #2)
MINIO_BUCKET=wenqu-docs
MINIO_SECURE=false               # 生产经内网明文可保持 false,对外必须 true

# ---------------------------- 模型 ----------------------------
# 模型清单见 server/config/models.yaml;各厂商密钥按下面对应变量注入,未用的留空即可
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=               # 阿里云百炼(Qwen 系列:chat/embedding/rerank)
ZHIPU_API_KEY=                   # 智谱 GLM
MOONSHOT_API_KEY=                # 月之暗面 Kimi
ARK_API_KEY=                     # 火山方舟(豆包)
MINIMAX_API_KEY=
OPENAI_API_KEY=                  # 海外预留
# 本地模型(Ollama/vLLM)无需密钥,base_url 在 models.yaml 配置
# APP_LLM_CONCURRENCY_BUDGET=8   # 后台任务按模型的并发预算(供应商限速 50% 起配,设计文档 ADR-4)

# ---------------------------- 解析服务 ----------------------------
PARSER_GRPC_ADDR=localhost:50051
PARSER_GRPC_TOKEN=               # 【生产必配】解析服务 gRPC Token(翻转项 #6);生产由 compose 强制
PARSER_REQUIRE_TOKEN=0           # 生产 compose 中固定为 1(未配置 Token 拒绝启动)

# ---------------------------- 认证 ----------------------------
APP_JWT_SECRET=                  # 【生产必配】JWT 签名密钥(翻转项 #3);缺失时 dev 随机生成并告警
APP_MASTER_KEY=                  # 【生产必配】AES-256-GCM 主密钥(凭据加密,翻转项 #3)

# ---------------------------- 可观测 ----------------------------
APP_OTLP_ENDPOINT=               # 留空=追踪关闭(nil-safe 零开销);上线前建议接入(P1)
